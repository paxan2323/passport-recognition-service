# API keys: key:client_id pairs, comma-separated
PASSPORT_API_KEYS=dev-key-001:default

# Production domain (Let's Encrypt)
CERTBOT_DOMAIN=pass.hermes-support.ru
CERTBOT_EMAIL=paxan232323@gmail.com

# Host path to trained models (optional). Linux production: /var/lib/docreader/models
DOCREADER_MODELS_HOST=/var/lib/docreader/models

# Длинная сторона > лимита — автоматически уменьшается (LANCZOS), не отклоняется
MAX_IMAGE_SIDE_PX=1600
